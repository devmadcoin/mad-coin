{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install && npx vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/:path(.*\\.png)", "destination": "/:path" },
    { "source": "/:path(.*\\.jpg)", "destination": "/:path" },
    { "source": "/:path(.*\\.jpeg)", "destination": "/:path" },
    { "source": "/:path(.*\\.webp)", "destination": "/:path" },
    { "source": "/:path(.*\\.gif)", "destination": "/:path" },
    { "source": "/:path(.*\\.mp4)", "destination": "/:path" },
    { "source": "/:path(.*\\.glb)", "destination": "/:path" },
    { "source": "/:path(.*\\.svg)", "destination": "/:path" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
